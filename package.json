{
  "name": "fire-retirement-calculator",
  "version": "2.0.0",
  "description": "Advanced FIRE (Financial Independence Retire Early) calculator with Monte Carlo simulations, CoastFIRE, and scenario analysis",
  "main": "index.html",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=calculator.test.js",
    "serve": "python -m http.server 8000 || python3 -m http.server 8000",
    "lint": "eslint tests/ --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techiecuriosity/finance-calculators.git"
  },
  "keywords": [
    "FIRE",
    "retirement calculator",
    "financial independence",
    "Monte Carlo simulation",
    "CoastFIRE",
    "Trinity Study",
    "4% rule",
    "retirement planning",
    "early retirement"
  ],
  "author": "Retirement Calculator Pro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/techiecuriosity/finance-calculators/issues"
  },
  "homepage": "https://www.retirementcalcpro.com/",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "tests/**/*.js",
      "!tests/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
